# Plantilla de infra/.env — còpia-la i omple-la:   cd infra && cp ../.env.example .env
# Guia completa de cada variable: docs/guia-administrador.md (§4)
# Després de canviar-lo:   docker compose up -d   (un "restart" NO rellegeix aquest fitxer)

# ── Obligatòries ─────────────────────────────────────────────────────────────
DB_NAME=examplatform
DB_USER=examuser
# Obligatori. Genera-la:  openssl rand -hex 24
# Només es fa servir en crear la base de dades: canviar-la després aquí no canvia la de PostgreSQL.
DB_PASS=
# Obligatori. Genera-la:  openssl rand -base64 48   (el backend no arrenca si és buit, públic o curt)
# Canviar-la tanca la sessió de tothom.
JWT_SECRET=

# ── Adreces (CORS i login amb Google) ───────────────────────────────────────
# URL pública de l'aplicació, sense barra final. Només la fa servir el login amb Google.
FRONTEND_URL=https://IP_O_NOM:3443
# Orígens des d'on es pot fer servir l'aplicació, separats per comes. Han de ser EXACTAMENT el que
# escriuen els usuaris al navegador (esquema, nom o IP i port); si no, no deixa entrar.
APP_ALLOWED_ORIGINS=https://IP_O_NOM:3443

# ── HTTPS (guia: docs/https.md) ─────────────────────────────────────────────
# Per activar-lo: genera els certificats i afegeix el fitxer https al COMPOSE_FILE.
# COMPOSE_FILE=docker-compose.yml:docker-compose.https.yml
# HTTPS_PORT=3443

# ── Execució del codi dels alumnes ──────────────────────────────────────────
# Grup del sistema "docker" (getent group docker | cut -d: -f3). Sense aquest valor correcte, el
# backend arrenca però CAP execució de codi funciona. El 984 per defecte és el d'una màquina concreta.
DOCKER_GID=
# Execucions simultànies a tota la màquina. 4 per defecte; amb molts alumnes entregant alhora, 16–24.
EXEC_MAX_CONCURRENT=4
# Segons que una execució pot esperar torn abans de fallar (si hi ha cua llarga, 60–120).
EXEC_QUEUE_WAIT=30
# Memòria de cada contenidor d'execució: 128m per a scripts; 192m–256m si hi ha molt de Java.
EXEC_MEMORY=128m
# Imatge de Java dels contenidors d'execució.
# JAVA_IMAGE=eclipse-temurin:21-jdk-alpine
# (El temps màxim de 15 s, les imatges de bash i PowerShell i la CPU són els del backend i no es
#  canvien des d'aquí: vegeu docs/guia-administrador.md §4.8.)

# ── Recursos ─────────────────────────────────────────────────────────────────
# Memòria màxima del backend (la JVM n'usa un 70 %). 1536m per defecte; 3g o més amb molts alumnes.
# BACKEND_MEM_LIMIT=1536m

# ── Login amb Google (opcional) ─────────────────────────────────────────────
# Buit = el botó no surt. Google només admet adreces amb nom de domini públic: per IP no funciona.
# Els dominis de correu permesos es configuren a l'aplicació (Configuració), no aquí.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Còpies de seguretat (servei "backup"; guia: docs/copies-seguretat.md) ───
# Directori on es desen (relatiu a infra/). Crea'l ABANS del primer "up": si el crea Docker, és de root.
# Millor en un disc diferent o sincronitzat fora de la màquina.
BACKUP_DIR=../backups
BACKUP_HORA=02:30
BACKUP_RETENCIO_DIES=30
# BACKUP_TZ=Europe/Madrid
# Usuari i grup propietaris de les còpies (id -u / id -g). Han de poder escriure a BACKUP_DIR.
BACKUP_UID=1000
BACKUP_GID=1000

# Còpia també a una carpeta compartida de la xarxa (SMB). Per activar-la, descomenta
# (si també tens l'HTTPS, afegeix-hi el fitxer https separat per «:»):
# COMPOSE_FILE=docker-compose.yml:docker-compose.copies-remotes.yml
# BACKUP_REMOT_SERVIDOR=192.168.1.10          # IP (no nom) del servidor de fitxers
# BACKUP_REMOT_RUTA=//192.168.1.10/copies/examens
# BACKUP_REMOT_USUARI=
# BACKUP_REMOT_CONTRASENYA=                   # sense comes
# BACKUP_REMOT_DOMINI=WORKGROUP
# BACKUP_REMOT_VERSIO_SMB=3.0
