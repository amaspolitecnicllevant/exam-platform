DB_NAME=examplatform
DB_USER=examuser
# Obligatori. Genera-la: openssl rand -base64 24
DB_PASS=

# Obligatori. Genera una clau aleatòria llarga: openssl rand -base64 48
# (el backend no arrenca si és buit o curt)
JWT_SECRET=
JWT_EXPIRATION_MS=14400000

# Google OAuth2 — obté les credencials a https://console.cloud.google.com/
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Només es permet login amb aquest domini (deixa buit per desactivar la restricció)
OAUTH_ALLOWED_DOMAIN=politecnicllevant.cat

# URL del frontend (sense barra final)
FRONTEND_URL=https://examens.example.com

# Orígens permesos per CORS (separa amb comes si n'hi ha més d'un)
APP_ALLOWED_ORIGINS=https://examens.example.com

# Execució d'scripts en Docker
SCRIPTS_HOST_PATH=/tmp/exam-scripts
EXEC_TIMEOUT=10
EXEC_MEMORY=128m
EXEC_CPUS=0.5
BASH_IMAGE=alpine:latest
PS_IMAGE=mcr.microsoft.com/powershell:latest

# Còpies de seguretat (servei "backup")
# Directori on es desen (relatiu a infra/); millor en un disc diferent o sincronitzat fora de la màquina
BACKUP_DIR=../backups
BACKUP_HORA=02:30
BACKUP_RETENCIO_DIES=30
# Usuari i grup del sistema propietari de les còpies (id -u / id -g)
BACKUP_UID=1000
BACKUP_GID=1000

# Còpia també a una carpeta compartida de la xarxa (SMB). Per activar-la, descomenta:
# COMPOSE_FILE=docker-compose.yml:docker-compose.copies-remotes.yml
# BACKUP_REMOT_SERVIDOR=192.168.1.10          # IP (no nom) del servidor de fitxers
# BACKUP_REMOT_RUTA=//192.168.1.10/copies/examens
# BACKUP_REMOT_USUARI=
# BACKUP_REMOT_CONTRASENYA=                   # sense comes
# BACKUP_REMOT_DOMINI=WORKGROUP
# BACKUP_REMOT_VERSIO_SMB=3.0
