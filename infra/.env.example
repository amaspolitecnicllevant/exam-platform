# Base de dades
DB_NAME=examplatform
DB_USER=examuser
DB_PASS=exampass

# JWT (canvia-ho en producció, mínim 32 caràcters)
JWT_SECRET=canviam-aquest-secret-en-produccio-min32chars!!

# URLs
FRONTEND_URL=http://localhost:3000
APP_ALLOWED_ORIGINS=http://localhost:3000

# Google OAuth2 — crea les credencials a https://console.cloud.google.com
# URI de redirecció autoritzada: http://localhost:8080/login/oauth2/code/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Domini OAuth permès (fallback si no es configura a la BD)
OAUTH_ALLOWED_DOMAIN=politecnicllevant.cat

# HTTPS (vegeu docs/https.md): port on se serveix; per activar-lo, afegeix docker-compose.https.yml a COMPOSE_FILE
# HTTPS_PORT=3443
